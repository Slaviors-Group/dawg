{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawg.dev/schema/manifest/v0.1.2-alpha.json",
  "title": "DAWG Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "title",
    "source",
    "layers",
    "sanitize",
    "determinism",
    "expectedOutcome"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.2-alpha"
    },
    "id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reporter",
        "environment",
        "repoCommit"
      ],
      "properties": {
        "reporter": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "repoCommit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaType",
          "digest",
          "size"
        ],
        "properties": {
          "mediaType": {
            "enum": [
              "application/vnd.dawg.env.lockfile+tar",
              "application/vnd.dawg.db.fixture+tar.zstd",
              "application/vnd.dawg.trace.rrweb+jsonl.zstd",
              "application/vnd.dawg.cassette+tar.zstd"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "sanitize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyVersion",
        "fieldsRedacted"
      ],
      "properties": {
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "fieldsRedacted": {
          "type": "integer",
          "minimum": 0
        },
        "reviewedBy": {
          "type": "string"
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clockFrozenAt",
        "randomSeed"
      ],
      "properties": {
        "clockFrozenAt": {
          "type": "string",
          "format": "date-time"
        },
        "randomSeed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signedBy",
        "attestation"
      ],
      "properties": {
        "signedBy": {
          "type": "string"
        },
        "attestation": {
          "type": "string"
        }
      }
    },
    "expectedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description",
        "assertionFile"
      ],
      "properties": {
        "type": {
          "const": "assertion"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "assertionFile": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}